{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-design",
  "version": "0.6.4",
  "description": "Local editable slides, canvases, design systems, and data dashboards for Codex.",
  "repository": "https://github.com/doomclouds/baoyu-design",
  "keywords": ["design", "slides", "canvas", "design-system", "dashboard", "dataviz"],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "codex design",
        "shortDescription": "Editable designs and charts",
        "category": "Productivity",
        "capabilities": ["Read", "Write", "Interactive"],
        "defaultPrompt": [
          "Use codex design to create an editable slide deck from these notes.",
          "Use codex design to build a dashboard from this CSV."
        ],
        "brandColor": "#D96839",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png"
      }
    }
  }
}
