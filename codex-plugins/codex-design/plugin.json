{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-design",
  "version": "0.7.1",
  "description": "Local editable slides, canvases, design systems, dashboards, and motion films for Codex.",
  "repository": "https://github.com/doomclouds/baoyu-design",
  "keywords": [
    "design",
    "slides",
    "canvas",
    "design-system",
    "dashboard",
    "motion",
    "video",
    "dataviz"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "codex design",
        "shortDescription": "Editable designs and films",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write",
          "Interactive"
        ],
        "defaultPrompt": [
          "Use codex design to create an editable slide deck from these notes.",
          "Use codex design to build a dashboard from this CSV.",
          "Use codex design to create an editable Motion film with narration."
        ],
        "brandColor": "#D96839",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png"
      }
    }
  }
}
